        "fix_complexity": "MEDIUM",
        "estimated_hours": 5,
        "solution_summary": "Implement bcrypt-based password verification against database"
      },
      {
        "id": "XSS-2.1",
        "title": "Query Parameters Not Sanitized for XSS",
        "category": "XSS",
        "severity": "CRITICAL",
        "file": "dashboard/lib/validation/middleware.ts",
        "lines": "296",
        "status": "VULNERABLE",
        "impact_level": "CRITICAL",
        "exploitability": "HIGH",
        "description": "Query parameters extracted and stored without sanitization. If rendered in HTML, XSS payloads execute.",
        "business_impact": "Attackers can inject malware, steal cookies/sessions, hijack user accounts.",
        "fix_complexity": "MEDIUM",
        "estimated_hours": 3.5,
        "solution_summary": "Apply DOMPurify sanitization to all query parameters before storage"
      },
      {
        "id": "INJ-1.1",
        "title": "SQL Injection Detection Unused",
        "category": "Injection",
        "severity": "CRITICAL",
        "file": "dashboard/lib/input-validation.ts",
        "lines": "252-266",
        "status": "DEFINED_NOT_CALLED",
        "impact_level": "CRITICAL",
        "exploitability": "DEPENDS_ON_PARAMETERIZATION",
        "description": "detectSqlInjection() function exists with comprehensive patterns but is never called. No enforcement of parameterized queries.",
        "business_impact": "If any database query uses string concatenation, attacker gains full database access.",
        "fix_complexity": "MEDIUM",
        "estimated_hours": 4.5,
        "solution_summary": "Enforce detectSqlInjection() on all user inputs; verify all queries are parameterized"
      },
      {
        "id": "RATE-7.1",
        "title": "Rate Limiter Falls Back to Shared 'anonymous' Key",
        "category": "Rate Limiting",
        "severity": "CRITICAL",
        "file": "dashboard/lib/rate-limiter.ts",
        "lines": "186",
        "status": "VULNERABLE",
        "impact_level": "CRITICAL",
        "exploitability": "IMMEDIATE",
        "description": "When IP cannot be determined, falls back to 'anonymous' bucket. All requests without IP share single quota.",
        "business_impact": "Rate limiting completely bypassed. Attackers can make unlimited requests from shared IP.",
        "fix_complexity": "LOW",
        "estimated_hours": 2,
        "solution_summary": "Reject request if IP cannot be determined; eliminate 'anonymous' fallback"
      },
      {
        "id": "DATA-5.1",
        "title": "Error Messages Expose Sensitive Data via Whitelist Bypass",
        "category": "Data Leakage",
        "severity": "CRITICAL",
        "file": "dashboard/lib/error-handling.ts",
        "lines": "150-164",
        "status": "VULNERABLE",
        "impact_level": "CRITICAL",
        "exploitability": "HIGH",
        "description": "Whitelist approach to error messages. Any error not in whitelist leaks full details: database schema, credentials, file paths.",
        "business_impact": "Attackers learn database structure, steal credentials from error messages, bypass security layers.",
        "fix_complexity": "MEDIUM",
        "estimated_hours": 3,
        "solution_summary": "Switch to blacklist approach with field-level redaction; log full details server-side only"
      }
    ]
